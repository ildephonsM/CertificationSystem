@page "/add-attendees"
@inject HttpClient Http
@using CertificationApp.Shared.Models

<PageTitle>Add Attendees</PageTitle>

<div class="container-fluid">
    <div class="main-container">
        <div class="content-area">
            <div class="d-flex mb-4">
                <NavLink href="/" class="back-btn" Match="NavLinkMatch.All">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </NavLink>

                <NavLink href="/all-learners" class="back-btn ms-3" Match="NavLinkMatch.All">
                    <i class="fas fa-users"></i> Attendess Certificate
                </NavLink>
            </div>

            <div class="form-container">
                <h2><i class="fas fa-user-plus"></i> Add Attendee</h2>
                <p class="text-muted mb-4">Select a user and venue to add as an attendee</p>

                <div class="form-group">
                    <label class="form-label">Select User *</label>
                    <select class="form-control wide-dropdown" @bind="SelectedUserId">
                        <option value="">-- Select User --</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.Name @user.Surname</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Select Venue (Trainee Name) *</label>
                    <select class="form-control wide-dropdown" @bind="selectedVenueId">
                        <option value="">-- Select Venue --</option>
                        @foreach (var venue in filteredVenues)
                        {
                            <option value="@venue.Id">@venue.TraineeName</option>
                        }
                    </select>
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary" @onclick="SubmitAttendee" disabled="@(!CanSubmit)">
                        <i class="fas fa-plus"></i> Add Attendee
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-3" @onclick="() => { selectedUserId = Guid.Empty; selectedVenueId = Guid.Empty; filteredVenues = new(); }">
                        <i class="fas fa-undo"></i> Reset
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @messageClass mt-4">@message</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Reuse same style rules as create.razor */
    .main-container {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 25px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        margin: 60px auto;
        max-width: 900px;
        overflow: hidden;
        padding: 50px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .back-btn {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #000000 100%);
        border: none;
        color: white;
        padding: 12px 25px;
        border-radius: 12px;
        transition: all 0.3s;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(30, 60, 114, 0.3);
    }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(30, 60, 114, 0.4);
            text-decoration: none;
        }

    .form-container {
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(30, 60, 114, 0.1);
    }

        .form-container h2 {
            color: #1e3c72;
            margin-bottom: 10px;
            font-weight: 800;
            font-size: 2rem;
        }

    .form-label {
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 10px;
        display: block;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 15px 20px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #fff;
    }

        .form-control:focus {
            border-color: #2a5298;
            box-shadow: 0 0 0 0.3rem rgba(42, 82, 152, 0.15);
            outline: none;
        }

    .wide-dropdown {
        width: 100%;
        min-width: 400px;
        max-width: 100%;
    }

    .btn-primary {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #000000 100%);
        border: none;
        padding: 15px 35px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s;
        color: white;
        font-size: 1rem;
        box-shadow: 0 6px 20px rgba(30, 60, 114, 0.3);
    }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(30, 60, 114, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.6;
        }

    .btn-outline-secondary {
        border: 2px solid #1e3c72;
        color: #1e3c72;
        background: transparent;
        padding: 15px 35px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s;
    }

        .btn-outline-secondary:hover {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
        }

    .alert-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 12px;
    }

    .alert-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 12px;
    }
</style>

@code {
    private List<CertificationApp.Shared.Models.CreateUser> users = new();
    private List<CertificationApp.Shared.Models.Venues> venues = new();
    private List<Venues> filteredVenues = new();

    private Guid selectedUserId;
    private Guid selectedVenueId;

    private string message = "";
    private string messageClass = "";

    protected override async Task OnInitializedAsync()
    {
        users = await Http.GetFromJsonAsync<List<CertificationApp.Shared.Models.CreateUser>>("api/Certificates") ?? new List<CertificationApp.Shared.Models.CreateUser>();
        venues = await Http.GetFromJsonAsync<List<CertificationApp.Shared.Models.Venues>>("api/Venue") ?? new List<CertificationApp.Shared.Models.Venues>();
    }

    private Guid SelectedUserId
    {
        get => selectedUserId;
        set
        {
            selectedUserId = value;
            LoadVenuesForUser();
        }
    }

    private void LoadVenuesForUser()
    {
        filteredVenues = venues;
    }

    private bool CanSubmit => selectedUserId != Guid.Empty && selectedVenueId != Guid.Empty;

    private async Task SubmitAttendee()
    {
        if (!CanSubmit)
        {
            message = "Please select both user and venue.";
            messageClass = "alert-danger";
            return;
        }

        var response = await Http.PostAsJsonAsync<object>($"api/Attendees?userId={selectedUserId}&venueId={selectedVenueId}", new { });

        if (response.IsSuccessStatusCode)
        {
            message = "Attendee added successfully!";
            messageClass = "alert-success";

            selectedUserId = Guid.Empty;
            selectedVenueId = Guid.Empty;
            filteredVenues = new();
        }
        else
        {
            message = "Error adding attendee. Please try again.";
            messageClass = "alert-danger";
        }
    }
}
