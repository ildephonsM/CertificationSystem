@page "/all-learners"
@using CertificationApp.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>All Learners</PageTitle>

<div class="container-fluid">
    <div class="main-container">
        <div class="content-area">

            <!-- Back Button -->
            <NavLink href="/" class="back-btn" Match="NavLinkMatch.All">
                <i class="fas fa-arrow-left"></i> Back to Home
            </NavLink>

            <!-- Learners Section -->
            <div class="form-container">
                <h2><i class="fas fa-users"></i> All Learners</h2>
                <p class="text-muted mb-4">Browse, search, and manage registered learners</p>

                <!-- Search Bar -->
                <div class="search-bar">
                    <input type="text" placeholder="Search learners..."
                           @bind="searchTerm" @bind:event="oninput" />
                </div>

                <!-- Learners Table -->
                <div class="table-responsive">
                    <table class="learners-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>ID Number</th>
                                <th>Registered Course</th>
                                <th>Date Completed</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var learner in FilteredLearners)
                            {
                                <tr>
                                    <td>
                                        @if (editLearner?.Id == learner.Id)
                                        {
                                            <input type="text" class="form-control" @bind="editLearner.Name" />
                                        }
                                        else
                                        {
                                            @learner.Name
                                        }
                                    </td>
                                    <td>
                                        @if (editLearner?.Id == learner.Id)
                                        {
                                            <input type="text" class="form-control" @bind="editLearner.Surname" />
                                        }
                                        else
                                        {
                                            @learner.Surname
                                        }
                                    </td>
                                    <td>@learner.IdNumber</td>
                                    <td>@learner.CourseName</td>
                                    <td>@learner.DateCompleted.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="action-buttons">
                                            @if (editLearner?.Id == learner.Id)
                                            {
                                                <button class="btn-edit" @onclick="() => SaveEdit(learner.Id)">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                                <button class="btn-delete cancel-btn" @onclick="CancelEdit">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-edit" @onclick="() => EditLearner(learner)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn-delete" @onclick="() => DeleteLearner(learner.Id)">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!FilteredLearners.Any())
                    {
                        <p class="text-center text-muted mt-3">No learners found.</p>
                    }
                </div>
            </div>

            <!-- Delete Confirmation Modal-->
            @if (showDeleteConfirmation)
            {
                <div class="modal-backdrop">
                    <div class="modal-dialog">
                        <h5>Are you sure you want to delete this learner?</h5>
                        <div class="modal-actions">
                            <button class="btn btn-danger" @onclick="ConfirmDelete">Yes, Delete</button>
                            <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* --- Main container --- */
    .main-container {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 25px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        margin: 60px auto;
        max-width: 1300px;
        overflow: hidden;
        padding: 50px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .back-btn {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #000000 100%);
        border: none;
        color: white;
        padding: 12px 25px;
        border-radius: 12px;
        margin-bottom: 40px;
        transition: all 0.3s ease;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(30, 60, 114, 0.3);
    }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(30, 60, 114, 0.4);
        }

    /* --- Form container --- */
    .form-container {
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(30, 60, 114, 0.1);
    }

        .form-container h2 {
            color: #1e3c72;
            margin-bottom: 10px;
            font-weight: 800;
            font-size: 2rem;
        }

    /* --- Search Bar --- */
    .search-bar {
        width: 100%;
        max-width: 400px;
        margin: 0 auto 20px auto;
        display: flex;
        justify-content: center;
    }

        .search-bar input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #ddd;
            border-radius: 25px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .search-bar input:focus {
                outline: none;
                border-color: #007bff;
                box-shadow: 0 0 8px rgba(0, 123, 255, 0.3);
            }

    /* --- Table --- */
    .learners-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

        .learners-table th,
        .learners-table td {
            padding: 14px 18px;
            text-align: left;
            word-wrap: break-word;
        }

        .learners-table th {
            background-color: #007bff;
            color: #fff;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .learners-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .learners-table tr:hover {
            background-color: #eef5ff;
            transition: background 0.2s ease-in-out;
        }

    /* --- Action Buttons --- */
    .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-edit, .btn-delete {
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-edit {
        background-color: #28a745;
        color: white;
    }

        .btn-edit:hover {
            background-color: #218838;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }
    
    .btn-delete:hover {
        background-color: #c82333;
    }

    .cancel-btn {
        background-color: #6c757d;
    }
    .cancel-btn:hover {
        background-color: #5a6268;
    }

    /* --- Modal --- */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-dialog {
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        max-width: 400px;
        width: 90%;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    .modal-actions {
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

        .modal-actions .btn {
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
        }


    /* --- Responsive --- */
    @@media (max-width: 768px) {
        .learners-table th, .learners-table td

    {
        padding: 10px;
        font-size: 14px;
    }

    .search-bar input {
        font-size: 14px;
        padding: 10px 14px;
    }

    }
    @@media (max-width: 480px) {
        .learners-table, .learners-table thead, .learners-table tbody, .learners-table th, .learners-table td, .learners-table tr

    {
        display: block;
        width: 100%;
    }

    .learners-table thead {
        display: none;
    }

    .learners-table tr {
        margin-bottom: 15px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 10px;
        background: #fff;
    }

    .learners-table td {
        display: flex;
        justify-content: space-between;
        padding: 8px 10px;
        border: none;
    }

        .learners-table td::before {
            content: attr(data-label);
            font-weight: 600;
            text-transform: uppercase;
            color: #007bff;
        }

    }
</style>

@code {
    private string searchTerm = string.Empty;
    private List<CertificationApp.Shared.Models.CreateUser> learners = new();
    private CertificationApp.Shared.Models.CreateUser? editLearner;

    // Delete confirmation
    private bool showDeleteConfirmation = false;
    private Guid learnerToDeleteId;

    protected override async Task OnInitializedAsync() => await LoadLearners();

    private async Task LoadLearners()
    {
        learners = await Http.GetFromJsonAsync<List<CertificationApp.Shared.Models.CreateUser>>("api/Certificates")
                   ?? new List<CertificationApp.Shared.Models.CreateUser>();
    }

    private IEnumerable<CertificationApp.Shared.Models.CreateUser> FilteredLearners => learners
        .Where(l =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            l.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            l.Surname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            l.IdNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void EditLearner(CertificationApp.Shared.Models.CreateUser learner)
    {
        editLearner = new CertificationApp.Shared.Models.CreateUser
        {
            Id = learner.Id,
            Name = learner.Name,
            Surname = learner.Surname,
            IdNumber = learner.IdNumber,
            CourseName = learner.CourseName,
            DateCompleted = learner.DateCompleted
        };
    }

    private async Task SaveEdit(Guid id)
    {
        if (editLearner == null) return;

        await Http.PutAsJsonAsync($"api/Certificates/{id}", editLearner);

        var learner = learners.FirstOrDefault(l => l.Id == id);
        if (learner != null)
        {
            learner.Name = editLearner.Name;
            learner.Surname = editLearner.Surname;
        }

        editLearner = null;
    }

    private void CancelEdit() => editLearner = null;

    // Delete logic with confirmation
    private void DeleteLearner(Guid id)
    {
        learnerToDeleteId = id;
        showDeleteConfirmation = true;
    }

    private async Task ConfirmDelete()
    {
        if (learnerToDeleteId != Guid.Empty)
        {
            await Http.DeleteAsync($"api/Certificates/{learnerToDeleteId}");
            learners.RemoveAll(l => l.Id == learnerToDeleteId);
        }
        showDeleteConfirmation = false;
        learnerToDeleteId = Guid.Empty;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        learnerToDeleteId = Guid.Empty;
    }
}
