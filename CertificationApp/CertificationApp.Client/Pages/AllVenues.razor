@page "/all-venues"
@using CertificationApp.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>All Venues</PageTitle>

<div class="container-fluid">
    <div class="main-container">
        <div class="content-area">

            <!-- Back Button -->
            <NavLink href="/" class="back-btn" Match="NavLinkMatch.All">
                <i class="fas fa-arrow-left"></i> Back to Home
            </NavLink>

            <!-- Venues Section -->
            <div class="form-container">
                <h2><i class="fas fa-map-marker-alt"></i> All Venues</h2>
                <p class="text-muted mb-4">Browse, search, and manage assigned venues</p>

                <!-- Search Bar -->
                <div class="search-bar mb-3">
                    <input type="text" placeholder="Search venues..."
                           @bind="searchTerm" @bind:event="oninput" class="form-control" />
                </div>

                <!-- Venues Table -->
                <div class="table-responsive">
                    <table class="venues-table">
                        <thead>
                            <tr>
                                <th>Trainee Name</th>
                                <th>Course Date</th>
                                <th>Course</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venue in FilteredVenues)
                            {
                                <tr>
                                    <td>
                                        @if (editVenue?.Id == venue.Id)
                                        {
                                            <input type="text" class="form-control" @bind="editVenue.TraineeName" />
                                        }
                                        else
                                        {
                                            @venue.TraineeName
                                        }
                                    </td>
                                    <td>
                                        @if (editVenue?.Id == venue.Id)
                                        {
                                            <InputDate @bind-Value="editVenue.CourseDate" class="form-control" />
                                        }
                                        else
                                        {
                                            @venue.CourseDate.ToString("yyyy-MM-dd")
                                        }
                                    </td>
                                    <td>
                                        @if (editVenue?.Id == venue.Id)
                                        {
                                            <InputSelect @bind-Value="editVenue.CourseId" class="form-control">
                                                <option value="">-- Select Course --</option>
                                                @foreach (var course in courseList)
                                                {
                                                    <option value="@course.Id">@course.CourseName</option>
                                                }
                                            </InputSelect>
                                        }
                                        else
                                        {
                                            @venue.Course?.CourseName
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons d-flex flex-wrap gap-2">
                                            @if (editVenue?.Id == venue.Id)
                                            {
                                                <button class="btn-edit" @onclick="() => SaveEdit(venue.Id)">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                                <button class="btn-delete cancel-btn" @onclick="CancelEdit">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-edit" @onclick="() => EditVenue(venue)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn-delete" @onclick="() => DeleteVenue(venue.Id)">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!FilteredVenues.Any())
                    {
                        <p class="text-center text-muted mt-3">No venues found.</p>
                    }
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            @if (showDeleteConfirmation)
            {
                <div class="modal-backdrop">
                    <div class="modal-dialog">
                        <h5>Are you sure you want to delete this venue?</h5>
                        <div class="modal-actions d-flex flex-wrap gap-2">
                            <button class="btn btn-danger" @onclick="ConfirmDelete">Yes, Delete</button>
                            <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .main-container {
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(15px);
        border-radius: 25px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        margin: 60px auto;
        max-width: 1300px;
        overflow: hidden;
        padding: 50px;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .back-btn {
        background: linear-gradient(135deg,#1e3c72 0%,#2a5298 50%,#000 100%);
        color: white;
        padding: 12px 25px;
        border-radius: 12px;
        margin-bottom: 20px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(30,60,114,0.3);
    }

        .back-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30,60,114,0.4);
        }

    .form-container {
        background: linear-gradient(145deg,#fff 0%,#f8f9fa 100%);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1), inset 0 1px 0 rgba(255,255,255,0.6);
        border: 1px solid rgba(30,60,114,0.1);
    }

        .form-container h2 {
            color: #1e3c72;
            font-weight: 800;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .form-container p {
            font-size: 0.9rem;
        }

    .search-bar input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 10px;
        border: 1px solid #ced4da;
    }

    .venues-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .venues-table th, .venues-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #dee2e6;
        }

    .action-buttons button {
        min-width: 80px;
        padding: 5px 12px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-edit {
        background: #1e3c72;
        color: white;
    }

        .btn-edit:hover {
            background: #2a5298;
        }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background: #c82333;
        }

    .cancel-btn {
        background: #6c757d;
    }

        .cancel-btn:hover {
            background: #5a6268;
        }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    .modal-dialog {
        background: white;
        padding: 25px 30px;
        border-radius: 15px;
        max-width: 400px;
        width: 90%;
        text-align: center;
    }

    .modal-actions button {
        flex: 1;
    }

    /* --- Responsive --- */
    @@media (max-width: 768px) {
        .main-container

    {
        padding: 30px;
    }

    .form-container {
        padding: 25px;
    }

    .venues-table th, .venues-table td {
        padding: 8px;
        font-size: 0.9rem;
    }

    .action-buttons {
        flex-direction: column;
        gap: 5px;
    }

    .modal-dialog {
        width: 95%;
    }

    }

    @@media (max-width: 480px) {
        .main-container

    {
        padding: 20px;
        margin: 20px 10px;
    }

    .form-container {
        padding: 15px;
    }

    .venues-table th, .venues-table td {
        font-size: 0.8rem;
        padding: 6px;
    }

    .search-bar input {
        padding: 10px;
        font-size: 0.85rem;
    }

    .back-btn {
        padding: 10px 18px;
        font-size: 0.85rem;
    }

    .action-buttons button {
        width: 100%;
        padding: 8px 0;
        font-size: 0.85rem;
    }

    }
</style>

@code {
    private string searchTerm = string.Empty;
    private List<Venues> venues = new();
    private List<Courses> courseList = new();
    private Venues? editVenue;

    private bool showDeleteConfirmation = false;
    private Guid venueToDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadVenues();
        courseList = await Http.GetFromJsonAsync<List<Courses>>("api/Courses") ?? new List<Courses>();
    }

    private async Task LoadVenues()
    {
        venues = await Http.GetFromJsonAsync<List<Venues>>("api/Venue") ?? new List<Venues>();
    }

    private IEnumerable<Venues> FilteredVenues => venues
        .Where(v =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            v.TraineeName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (v.Course?.CourseName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    private void EditVenue(Venues venue)
    {
        editVenue = new Venues
        {
            Id = venue.Id,
            TraineeName = venue.TraineeName,
            CourseDate = venue.CourseDate,
            CourseId = venue.CourseId
        };
    }

    private async Task SaveEdit(Guid id)
    {
        if (editVenue == null) return;

        await Http.PutAsJsonAsync($"api/Venue/{id}", editVenue);

        var venue = venues.FirstOrDefault(v => v.Id == id);
        if (venue != null)
        {
            venue.TraineeName = editVenue.TraineeName;
            venue.CourseDate = editVenue.CourseDate;
            venue.CourseId = editVenue.CourseId;
        }

        editVenue = null;
    }

    private void CancelEdit() => editVenue = null;

    private void DeleteVenue(Guid id)
    {
        venueToDeleteId = id;
        showDeleteConfirmation = true;
    }

    private async Task ConfirmDelete()
    {
        if (venueToDeleteId != Guid.Empty)
        {
            await Http.DeleteAsync($"api/Venue/{venueToDeleteId}");
            venues.RemoveAll(v => v.Id == venueToDeleteId);
        }
        showDeleteConfirmation = false;
        venueToDeleteId = Guid.Empty;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        venueToDeleteId = Guid.Empty;
    }
}
